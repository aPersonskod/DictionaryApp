<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:DictionaryDesktopApp.View"
                    xmlns:vw="clr-namespace:DictionaryApp.WPF.ViewModel">
    <DataTemplate DataType="{x:Type vw:WordsViewModel}">
        <view:WordsControl/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vw:AddEntryViewModel}">
        <view:AddWordControl/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vw:UpdateEntryViewModel}">
        <view:UpdateWord/>
    </DataTemplate>
</ResourceDictionary>