<UserControl x:Class="DictionaryDesktopApp.View.UpdateWord"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DictionaryDesktopApp.View"
             xmlns:viewModel="clr-namespace:DictionaryApp.WPF.ViewModel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModel:UpdateEntryViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel Grid.Row="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Back" Command="{Binding CmdGoWords}"/>
        </Grid>
        <TextBlock Text="Word:"/>
        <TextBox x:Name="WordTextBox" Text="{Binding WordText}"/>
        <TextBlock Text="Translate:"/>
        <TextBox Text="{Binding TranslateText}"/>
        <Button Content="Update word" Command="{Binding CmdUpdateWord}"/>
    </StackPanel>
</UserControl>
