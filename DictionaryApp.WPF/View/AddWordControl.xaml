<UserControl x:Class="DictionaryDesktopApp.View.AddWordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DictionaryDesktopApp.View"
             xmlns:viewModel="clr-namespace:DictionaryApp.WPF.ViewModel"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModel:AddEntryViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Back" Command="{Binding CmdGoWords}"/>
            </Grid>
            <TextBlock Text="Word:"/>
            <TextBox x:Name="WordTextBox" Text="{Binding EntryWord}"/>
            <TextBlock Text="Translate:"/>
            <TextBox x:Name="TranslateTextBox" Text="{Binding EntryTranslate, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CmdAddWord}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Add word" Command="{Binding CmdAddWord}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Import txt where words in format 'word-tr1, tr2':"/>
            <Button Content="Import txt file" Command="{Binding CmdImportTxt}"/>
            <Button Content="Import json file" Command="{Binding CmdImportJson}"/>
        </StackPanel>
    </Grid>
</UserControl>
